+const compareTitle = (a: Task, b: Task): number => a.title.localeCompare(b.title);
+
+/** Chronological in the given direction; tasks with no due date come last either way. */
+function compareDue(a: Task, b: Task, direction: Direction): number {
+  if (a.due === null || b.due === null) return a.due === b.due ? 0 : a.due === null ? 1 : -1;
+  const difference = Date.parse(a.due) - Date.parse(b.due);
+  return direction === "asc" ? difference : -difference;
+}
 
 export function sortTasks(tasks: readonly Task[], column: Column, direction: Direction): Task[] {
-  const sorted = [...tasks].sort(comparators[column]);
+  if (column === "due") return [...tasks].sort((a, b) => compareDue(a, b, direction));
+  const sorted = [...tasks].sort(compareTitle);
   return direction === "asc" ? sorted : sorted.reverse();
 }
