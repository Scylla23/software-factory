+import { expect, test } from "bun:test";
+import { LIST_TASKS } from "./queries";
+
+test("AC-1: the list query selects priority and every column it selected before", () => {
+  const selected = LIST_TASKS.slice("SELECT ".length, LIST_TASKS.indexOf(" FROM ")).split(", ");
+  expect(selected).toEqual(["id", "owner_id", "title", "due", "assignee", "legacy_notes", "priority"]);
+});
