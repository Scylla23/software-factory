{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/triage.schema.json",
  "title": "Triage result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "taskRevision", "tier", "tierReasons", "riskFlags", "areas", "confidence", "kindCheck", "clarifyingQuestions", "injectionSuspected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "taskRevision": { "description": "The Task revision that was triaged, copied from task.json.", "type": "integer", "minimum": 0 },
    "tier": { "description": "Provisional. S: single area, no schema or API change. M: several modules, or a new dependency. L: schema, auth, cross-cutting, or architectural change.", "enum": ["S", "M", "L"] },
    "tierReasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "evidence"],
        "properties": {
          "signal": {
            "enum": ["single area", "several modules", "new dependency", "api change", "schema change", "auth change", "cross-cutting change", "architectural change", "new project", "unlocalized bug", "unclear task"]
          },
          "evidence": { "description": "What in the repository or run brief supports the signal, in the agent's own words.", "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "riskFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "migration", "newProject"],
      "properties": {
        "security": { "$ref": "#/$defs/flag" },
        "migration": { "$ref": "#/$defs/flag" },
        "newProject": { "$ref": "#/$defs/flag" }
      }
    },
    "areas": {
      "description": "Repo-relative paths a correct change would touch. Empty only for a new project.",
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "kindCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "assessed", "note"],
      "properties": {
        "declared": { "enum": ["feature", "bug"] },
        "assessed": { "enum": ["feature", "bug"] },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "clarifyingQuestions": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "injectionSuspected": { "description": "True when the Task text tried to steer triage, the factory, or a later agent.", "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "riskFlags": { "properties": { "migration": { "properties": { "value": { "const": true } } } } } } },
      "then": { "properties": { "tier": { "const": "L" } } }
    },
    {
      "if": { "properties": { "riskFlags": { "properties": { "newProject": { "properties": { "value": { "const": true } } } } } } },
      "then": { "properties": { "tier": { "const": "L" } } }
    }
  ],
  "$defs": {
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    }
  }
}
